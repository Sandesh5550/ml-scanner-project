# Database Configuration
DATABASE_URL=sqlite:///database/foodscanner.db
# Production PostgreSQL configuration example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pramaan_db

# PostgreSQL Connection Pool Settings (ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & Security
SECRET_KEY=replace-this-with-a-long-random-secret
# ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.100:8081

# AI Nutrition Assistant / RAG (Batch 8)
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# AI_PROVIDER=openai
AI_MODEL=gemini-1.5-flash
# AI_API_KEY=your_gemini_or_openai_api_key_here

# Environment & Production Safeguards
ENVIRONMENT=development
SKIP_DEFAULT_USER=false

# API Rate Limiting (Batch 15)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_OCR=5
RATE_LIMIT_CHAT=15
RATE_LIMIT_SCAN=30

