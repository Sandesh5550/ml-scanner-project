# ==============================================================================
# PRAMAAN — Local Development Environment Template (Docker Compose)
# ==============================================================================
# NOTICE:
#   This template contains LOCAL-DEVELOPMENT PLACEHOLDERS ONLY.
#   It is designed exclusively for local Docker Compose development and testing.
#
# USAGE (Local Development):
#   Copy this file to '.env' in the project root:
#     cp .env.example .env
#
# SECURITY & PRODUCTION RULES:
#   - NEVER commit a '.env' file containing real secrets to version control.
#   - NEVER use these development default values in staging or production.
#   - CLOUD PRODUCTION DEPLOYMENTS (Render, AWS, GCP, Azure, Kubernetes):
#     Production secrets (SECRET_KEY, DATABASE_URL, AI_API_KEY, admin credentials)
#     MUST be injected directly through the hosting platform's environment variables
#     or secret management system (e.g., Render Environment Variables, AWS Secrets
#     Manager, Azure Key Vault, or GitHub Actions Secrets). Never deploy local .env
#     files to cloud environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000

# Security Secret Key:
# Used for JWT signing and session security. Minimum 32 characters required.
# LOCAL DEVELOPMENT PLACEHOLDER ONLY (replace in production with a strong random key):
SECRET_KEY=dev_local_secret_key_minimum_32_characters_for_docker_compose_only

# Allowed CORS Origins (comma-separated; leave blank for development defaults):
# ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.100:8081

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# DATABASE_URL Precedence & Behavior in Docker Compose:
#
# 1. AUTOMATIC RESOLUTION (Recommended for local Docker Compose):
#    Leave DATABASE_URL blank or commented out.
#    - When starting with '--profile postgres' or '--profile full', Docker Compose
#      automatically resolves and connects to the healthy local PostgreSQL container.
#    - When starting without profiles, Docker Compose automatically falls back to
#      the local SQLite database (sqlite:////app/database/foodscanner.db).
#
# 2. EXPLICIT OVERRIDE (Takes absolute precedence):
#    Any non-empty DATABASE_URL provided here or in the host environment will
#    ALWAYS be honored without automatic override, whether SQLite, local PostgreSQL,
#    or a managed cloud PostgreSQL instance (e.g., AWS RDS, Supabase, Neon, Render).
#
# Examples of explicit overrides:
# DATABASE_URL=sqlite:////app/database/foodscanner.db
# DATABASE_URL=postgresql://pramaan_dev_user:pramaan_dev_password@postgres:5432/foodscanner_dev_db
# DATABASE_URL=postgresql://cloud_user:cloud_password@aws-rds-endpoint.amazonaws.com:5432/production_db

# Local PostgreSQL Container Credentials (used by 'postgres' service in compose):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pramaan_dev_user
POSTGRES_PASSWORD=pramaan_dev_password
POSTGRES_DB=foodscanner_dev_db

# PostgreSQL Connection Pool Settings (tuning for SQLAlchemy pool):
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. AI Nutrition Assistant & OCR Engine
# ------------------------------------------------------------------------------
FOODSCANNER_OCR_ENGINE=tesseract

# AI Provider ('mock', 'gemini', or 'openai')
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
# AI_API_KEY=your_gemini_or_openai_api_key_placeholder

# ------------------------------------------------------------------------------
# 4. API Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_OCR=5
RATE_LIMIT_CHAT=15
RATE_LIMIT_SCAN=30

# ------------------------------------------------------------------------------
# 5. Monitoring Stack (Prometheus & Grafana)
# ------------------------------------------------------------------------------
# Activated with: docker compose --profile monitoring up
#             or: docker compose --profile full up
GRAFANA_ADMIN_USER=dev_local_admin
GRAFANA_ADMIN_PASSWORD=dev_local_admin_password
